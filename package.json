{
  "name": "watchtower-landing",
  "version": "1.0.0",
  "description": "Watchtower is a public-facing recycling network that connects residents, businesses, operators, and dispatch into one simple experience.",
  "main": "operator-auth.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node tests/static-server.js",
    "test": "npm run test:api-marketplace && npm run test:api-resident && npm run test:scanner-checkpoint",
    "test:api-resident": "node --test --test-isolation=none tests/resident-collection-api.test.js",
    "test:api-marketplace": "node --test --test-isolation=none tests/api-marketplace.test.js",
    "test:scanner-checkpoint": "playwright test tests/canonical-scanner.spec.js",
    "test:scanner-checkpoint:headed": "playwright test tests/canonical-scanner.spec.js --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgerard4050/watchtower-landing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rgerard4050/watchtower-landing/issues"
  },
  "homepage": "https://github.com/rgerard4050/watchtower-landing#readme",
  "dependencies": {
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
