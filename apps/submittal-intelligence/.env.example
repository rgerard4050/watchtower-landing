# Server-only OpenAI configuration. Never expose these values in browser code.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_SUBMITTAL_MODEL=gpt-5.6-luna

# Vercel deployments use VERCEL_OIDC_TOKEN automatically. This optional static
# key is only for non-Vercel hosts or local development.
AI_GATEWAY_API_KEY=
MORROW_GATEWAY_MODEL=google/gemini-2.5-flash

# Optional direct Gemini fallback. Google AI Studio Starter Tier must be used
# only with sanitized documents containing no confidential or personal data.
GOOGLE_GENERATIVE_AI_API_KEY=
MORROW_GOOGLE_MODEL=gemini-2.5-flash

# Stripe checkout is fail-closed until explicitly set to test or live.
# Prefer a restricted key with Checkout Session read/write permissions.
SUBMITTAL_PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=

# Explicit public origin for Checkout redirects.
SUBMITTAL_APP_ORIGIN=http://localhost:4175
