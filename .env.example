# Server-only Vercel Function configuration. Never expose the service role or signing secret in browser code.
ANTHROPIC_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANALYSIS_SIGNING_SECRET=

# Production x402 v2 payment gate on Base mainnet.
# X402_PAY_TO is the existing EVM address that receives USDC and WTWR.
X402_PAY_TO=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
PUBLIC_API_ORIGIN=https://app.ocalaassetsecurity.com

# Paid provider integrations.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
SAM_GOV_API_KEY=

# Choose either a Gemini API key or a Google Cloud/Vertex AI project.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Existing optional payment configuration (not used by the Resident Scanner demo).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
